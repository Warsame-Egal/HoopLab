# PostgreSQL
POSTGRES_DB=hooplab
POSTGRES_USER=hooplab
POSTGRES_PASSWORD=changeme

# Spring Boot (Phase 1+)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hooplab
# Optional: require X-Admin-Key on POST /api/admin/* (leave empty for local dev)
HOOPLAB_ADMIN_API_KEY=
INGESTION_BASE_URL=http://localhost:8000
SERVER_URL=http://localhost:8080

NBA_API_CONFIG=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:8080

# Ingestion backfill (backend)
HOOPLAB_INGEST_SEASONS_BACK=8
HOOPLAB_INGEST_MEASURES=Base,Advanced

# Frontend (Phase 5+)
VITE_API_BASE_URL=http://localhost:8080

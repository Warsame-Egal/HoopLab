# Spring Boot: base URL of the FastAPI data service it proxies to.
DATA_BASE_URL=http://localhost:8000

# Swagger "servers" entry shown in the API docs.
SERVER_URL=http://localhost:8080

# nba_api proxy. stats.nba.com blocks many datacenter IPs, so set this for cloud deploys.
# The data service accepts either NBA_API_PROXY or NBA_API_CONFIG (proxy URL).
NBA_API_PROXY=
NBA_API_CONFIG=

# CORS: origins allowed to call the Spring API (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# CORS: origins allowed to call the data service directly (comma-separated).
ALLOWED_ORIGINS=http://localhost:8080

# Frontend build-time config (empty = same-origin; nginx proxies /api and /ws to Spring).
VITE_API_BASE_URL=
VITE_WS_URL=
